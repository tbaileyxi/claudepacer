# Vercel deployment configuration
# Copy this to .env.local and fill in your values

# Domain for the website (Vercel will set this automatically)
VERCEL_URL=https://claudepacer.vercel.app

# Custom domain (if you have one)
CUSTOM_DOMAIN=https://claudepacer.com

# Analytics (optional)
VERCEL_ANALYTICS_ID=

# No API keys needed - static site only
