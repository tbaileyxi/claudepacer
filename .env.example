# ─────────────────────────────────────────────────────────────────────────────
# ClaudePacer — Environment Configuration
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ──────────────────────────────────────────────────────────────────

# Your Anthropic API key (get it at console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-xxxx

# A secret key for LiteLLM admin endpoints — make this long and random
# Example: openssl rand -hex 32
LITELLM_MASTER_KEY=sk-litellm-xxxx

# ── Usage Limits ──────────────────────────────────────────────────────────────

# Your weekly token budget (default: 1,000,000 — roughly Claude Pro limits)
# Adjust to match your plan or spend comfort level
WEEKLY_TOKEN_LIMIT=1000000

# ── App URL ───────────────────────────────────────────────────────────────────

# The public URL where your dashboard is hosted (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# A random secret for session signing — generate with: openssl rand -hex 32
NEXTAUTH_SECRET=changeme-generate-a-real-secret

# ── Payments (optional — needed to enable the $29 lifetime upgrade) ───────────

# Get these from your Stripe dashboard at dashboard.stripe.com
STRIPE_SECRET_KEY=sk_test_xxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxx

# The Stripe Price ID for the $29 lifetime plan
# Create a one-time price in Stripe for $29 and paste the ID here
LIFETIME_PRICE_ID=price_xxxx
